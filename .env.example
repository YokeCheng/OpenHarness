# OpenHarness API Configuration Example
# Copy this file to .env and modify the values for your environment

# ================================
# API SERVER CONFIGURATION
# ================================

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=info

# ================================
# TEXT LLM CONFIGURATION
# ================================

# Primary text model configuration
# Choose one provider and configure accordingly

## Option 1: Anthropic Claude (Recommended for general use)
# OPENHARNESS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENHARNESS_MODEL=claude-sonnet-4-6

## Option 2: OpenAI GPT
# OPENHARNESS_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENHARNESS_MODEL=gpt-4o

## Option 3: Qwen (DashScope) - Recommended for Chinese content
OPENHARNESS_PROVIDER=dashscope
DASHSCOPE_API_KEY=your-dashscope-api-key-here
OPENHARNESS_MODEL=qwen-plus

## Option 4: DeepSeek
# OPENHARNESS_PROVIDER=modelscope
# MODELSCOPE_API_KEY=your-modelscope-api-key-here
# OPENHARNESS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ================================
# MULTIMODAL / IMAGE GENERATION CONFIGURATION
# ================================

# Image generation model configuration
# This is used by the image_generation tool in Skills

## Option 1: OpenAI DALL-E (for image generation)
# OPENHARNESS_IMAGE_GENERATION_PROVIDER=openai
# OPENHARNESS_IMAGE_GENERATION_API_KEY=your-openai-api-key-here
# OPENHARNESS_IMAGE_GENERATION_MODEL=dall-e-3
# OPENHARNESS_IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1

## Option 2: Qwen Multimodal (for both text and image understanding/generation)
OPENHARNESS_IMAGE_GENERATION_PROVIDER=dashscope
OPENHARNESS_IMAGE_GENERATION_API_KEY=your-dashscope-api-key-here
OPENHARNESS_IMAGE_GENERATION_MODEL=qwen-vl-plus
OPENHARNESS_IMAGE_GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

## Option 3: Moonshot (Kimi)
# OPENHARNESS_IMAGE_GENERATION_PROVIDER=moonshot
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# OPENHARNESS_IMAGE_GENERATION_MODEL=kimi-k2.5
# OPENHARNESS_IMAGE_GENERATION_BASE_URL=https://api.moonshot.cn/v1

# ================================
# VISION MODEL CONFIGURATION (for image understanding)
# ================================

# Vision model is used as fallback when primary model doesn't support multimodal input
# OPENHARNESS_VISION_MODEL=gpt-4o
# OPENHARNESS_VISION_API_KEY=your-openai-api-key-here
# OPENHARNESS_VISION_BASE_URL=https://api.openai.com/v1

# For Qwen vision model:
OPENHARNESS_VISION_MODEL=qwen-vl-plus
OPENHARNESS_VISION_API_KEY=your-dashscope-api-key-here
OPENHARNESS_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ================================
# FINANCIAL HOTSPOT PIPELINE SPECIFIC
# ================================

# These can be used if you want to override defaults in your Skills
# FINANCIAL_PIPELINE_CONTENT_TYPE=xingfengxiang
# FINANCIAL_PIPELINE_MAX_HOTSPOT_ITEMS=10
# FINANCIAL_PIPELINE_OUTPUT_DIR=./data/financial_hotspot_pipeline

# ================================
# DEBUGGING AND DEVELOPMENT
# ================================

# Enable debug mode for more verbose logging
# OPENHARNESS_DEBUG=true

# Set effort level (low, medium, high, max)
# OPENHARNESS_EFFORT=medium